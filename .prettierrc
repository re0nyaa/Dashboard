{
    "$schema": "https://json.schemastore.org/prettierrc",
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,

    "semi": false,
    "singleQuote": false,
    "jsxSingleQuote": false,

    "trailingComma": "es5",
    "bracketSpacing": true,
    "bracketSameLine": false,

    "arrowParens": "always",

    "proseWrap": "never",
    "htmlWhitespaceSensitivity": "css",

    "endOfLine": "lf",

    "jsxBracketSameLine": false
}
